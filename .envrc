# Configuração local do Pynkaro para uso com direnv.
# Este arquivo contém os padrões do código e não inclui chaves reais.
# Chave da API Anthropic. A ordem de prioridade é Keychain, config.json e env.
# O padrão é não definir; para usar env, troque por:
# export ANTHROPIC_API_KEY="sk-ant-..."
# Chave da API ElevenLabs. Sem ela, o app usa a voz do sistema.
# O padrão é não definir; para usar env, troque por:
# export ELEVENLABS_API_KEY="..."
unset ANTHROPIC_API_KEY
unset ELEVENLABS_API_KEY
unset OPENAI_API_KEY
dotenv # Carrega as variáveis de ambiente do arquivo .env, se existir.

# ID do modelo Anthropic habilitado na conta.
# Padrão do código: claude-sonnet-5.
export PYNKARO_MODEL="claude-sonnet-5"

# Controla a busca na web da Anthropic.
# Use 0 para desativar; qualquer outro valor mantém a busca ativada.
export PYNKARO_WEB_SEARCH="1"

# Palavras de ativação separadas por vírgula.
# Espaços, maiúsculas, minúsculas e acentos são ignorados na comparação.
# Caso tenha dificuldades com a detecção, veja como o MacOs está detectando sua fala
# ativando o ditado e falando as palavras de ativação. Ajuste a lista conforme necessário.
export PYNKARO_WAKE_WORDS="pincaro,Ícaro,ícaro,icaro,pimcaro,pink,pica,pinga,fica"

# Imprime cada transcrição parcial distinta reconhecida pelo macOS.
# Use 1 para ativar; qualquer outro valor mantém o modo desativado.
# Util para depuração de problemas de reconhecimento de fala.
export PYNKARO_VERBOSE="1"

# Nome exato de uma voz do sistema instalada no macOS, como Felipe.
# O padrão é não definir, selecionando automaticamente a melhor voz pt-BR.
unset PYNKARO_VOICE

# ID da voz ElevenLabs.
# export ELEVENLABS_VOICE_ID="f016iUUEKqhX0trYHH6Q" # Padrão
# export ELEVENLABS_VOICE_ID="9yzdeviXkFddZ4Oz8Mok" # Lutz
export ELEVENLABS_VOICE_ID="onwK4e9ZLuTAKqWW03F9" # Daniel
# export ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb" # George
# export ELEVENLABS_VOICE_ID="nPczCjzI2devNBz1zQrb" # Brian
# export ELEVENLABS_VOICE_ID="iP95p4xoKVk53GoZ742B" # Chris
# Outras vozes
# export ELEVENLABS_VOICE_ID="FB9t7w9dj2IYiysoM5p6" # Paulo
# export ELEVENLABS_VOICE_ID="Zxr2vdABom9UBVX8c10U" # Nando
# export ELEVENLABS_VOICE_ID="lWq4KDY8znfkV0DrK8Vb" # Yasmin

# Modelo de síntese da ElevenLabs.
# Use eleven_multilingual_v2 para qualidade ou eleven_flash_v2_5 para latência.
# export ELEVENLABS_MODEL="eleven_multilingual_v2"
export ELEVENLABS_MODEL="eleven_flash_v2_5"

# Nome da state machine dentro do arquivo avatar.riv.
# Altere somente se o rig usar outro nome.
# export PYNKARO_RIVE_STATE_MACHINE="State Machine 1"

# Nome do input numérico da boca na state machine do Rive.
# O app envia valores de 0 a 4; altere se o rig usar outro nome.
# export PYNKARO_RIVE_INPUT="mouth"
